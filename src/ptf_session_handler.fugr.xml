       <PARAMETER>LT_RETURN</PARAMETER>
       <TYP>I</TYP>
      </RSEXP>
     </EXPORT>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>LT_RETURN</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>LT_STEP_DATA</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
      <RSFDO>
       <PARAMETER>LS_STEP_DATA</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
