   <LONGTEXTS>
    <item>
     <DOKIL>
      <ID>DE</ID>
      <OBJECT>PTF_REF_STEP</OBJECT>
      <LANGU>E</LANGU>
      <TYP>E</TYP>
      <VERSION>0009</VERSION>
      <MASTERLANG>X</MASTERLANG>
      <TXTLINES>00013</TXTLINES>
      <DOKSTATE>A</DOKSTATE>
     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>PTF_REF_STEP</TDNAME>
      <TDID>DE</TDID>
      <TDSPRAS>E</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00009</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEFINITION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>The reference business object is the predecessor on which the defined</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>action for the defined business object is performed.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>If there is more than one reference business object, you can enter all</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>reference steps divided by semicolons.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;USE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEPENDENCIES&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;EXAMPLE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N1</TDFORMAT>
       <TDLINE>Create a debit memo request.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N1</TDFORMAT>
       <TDLINE>Create a second debit memo request.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N1</TDFORMAT>
       <TDLINE>If you now want to remove the billing block, the system must know</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>whether the reference step:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N2</TDFORMAT>
       <TDLINE>- equates step 1, which means debit memo request 1</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N2</TDFORMAT>
       <TDLINE>- equates step 2, which means debit memo request 2</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>N2</TDFORMAT>
       <TDLINE>- equates step 1 and 2 which means the billing block for both debit memo</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>requests 1 and 2 will be removed.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>In the last case, enter 1 ; 2 in field Reference Step.</TDLINE>
      </TLINE>
     </LINES>
    </item>
   </LONGTEXTS>
