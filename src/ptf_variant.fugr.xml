      </RSTBL>
      <RSTBL>
       <PARAMETER>ET_VAR_TAG_MAP</PARAMETER>
       <DBSTRUCT>PTF_VAR_TAG_MAP</DBSTRUCT>
      </RSTBL>
     </TABLES>
     <EXCEPTION>
      <RSEXC>
       <EXCEPTION>NOT_FOUND</EXCEPTION>
      </RSEXC>
      <RSEXC>
       <EXCEPTION>NOT_AUTHORIZED</EXCEPTION>
      </RSEXC>
     </EXCEPTION>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>IV_NAME</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Variant Name in PTF</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ET_VARCON</PARAMETER>
       <KIND>P</KIND>
