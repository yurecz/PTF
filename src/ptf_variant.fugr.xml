      </RSEXP>
      <RSEXP>
       <PARAMETER>EV_CLIENT</PARAMETER>
       <TYP>PTF_CLIENT</TYP>
      </RSEXP>
     </EXPORT>
     <TABLES>
      <RSTBL>
       <PARAMETER>ET_VARID</PARAMETER>
       <DBSTRUCT>PTF_VARID</DBSTRUCT>
      </RSTBL>
      <RSTBL>
       <PARAMETER>ET_VARREF</PARAMETER>
