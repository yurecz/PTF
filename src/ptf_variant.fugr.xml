   </INCLUDES>
   <FUNCTIONS>
    <item>
     <FUNCNAME>EXECUTE_PTF_VARIANT</FUNCNAME>
     <REMOTE_CALL>R</REMOTE_CALL>
     <SHORT_TEXT>Executes a PTF variant</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>VARIANT</PARAMETER>
       <TYP>PTF_VARNAME</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>EXECUTION_RESULT</PARAMETER>
       <TYP>I_PTF_EXECUTION_RESULT</TYP>
      </RSEXP>
     </EXPORT>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>VARIANT</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Variant Name in PTF</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>EXECUTION_RESULT</PARAMETER>
       <KIND>P</KIND>
      </RSFDO>
     </DOCUMENTATION>
    </item>
    <item>
     <FUNCNAME>PTF_EXECUTE_SCRIPT</FUNCNAME>
     <REMOTE_CALL>R</REMOTE_CALL>
     <SHORT_TEXT>Executes a PTF script</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IV_NAME</PARAMETER>
       <TYP>PTF_VARNAME</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>ET_LOG</PARAMETER>
       <TYP>PTF_STRING_TAB</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>EV_RCODE</PARAMETER>
       <TYP>SYSUBRC</TYP>
      </RSEXP>
     </EXPORT>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>IV_NAME</PARAMETER>
       <KIND>P</KIND>
       <STEXT>PTF Script Name</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>ET_LOG</PARAMETER>
       <KIND>P</KIND>
       <STEXT>String Table</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>EV_RCODE</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Return Code (0:ok ; 1:failed)</STEXT>
      </RSFDO>
     </DOCUMENTATION>
    </item>
    <item>
     <FUNCNAME>PTF_READ_SCRIPT</FUNCNAME>
     <REMOTE_CALL>R</REMOTE_CALL>
