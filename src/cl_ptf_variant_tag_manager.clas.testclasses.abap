          exp_flair_variants TYPE cl_ptf_variant_tag_manager=>ptf_var_tag_map_table.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'ABC' ) TO exp_bliss_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'GHI' ) TO exp_bliss_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'JKL' ) TO exp_bliss_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1PRIVATE' varname = 'JKL' ) TO exp_bliss_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' varname = 'DEF' ) TO exp_bliss_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' varname = 'JKL' ) TO exp_bliss_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#3' varname = 'GHI' ) TO exp_bliss_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#4' varname = 'ABC' ) TO exp_bliss_variants.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'ABC' ) TO exp_flair_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'GHI' ) TO exp_flair_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'JKL' ) TO exp_flair_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' varname = 'DEF' ) TO exp_flair_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' varname = 'JKL' ) TO exp_flair_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#3' varname = 'GHI' ) TO exp_flair_variants.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#4' varname = 'ABC' ) TO exp_flair_variants.


    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' visibility = 'PUBLIC' creationdat = '20200420' creator = '_SAPBliss' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1PRIVATE' visibility = 'PRIVATE' creationdat = '20200420' creator = '_SAPBliss' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' visibility = 'PUBLIC' creationdat = '20200420' creator = '_SAPLynch' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2PRIVATE' visibility = 'PRIVATE' creationdat = '20200420' creator = '_SAPLynch' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#3' visibility = 'PUBLIC' creationdat = '20200420' creator = '_SAPBanks' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#3PRIVATE' visibility = 'PRIVATE' creationdat = '20200420' creator = '_SAPBanks' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#4' visibility = 'PUBLIC' creationdat = '20200420' creator = '_SAPFlair' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#4PRIVATE' visibility = 'PRIVATE' creationdat = '20200420' creator = '_SAPFlair' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#5' visibility = 'PUBLIC' creationdat = '20200420' creator = '_SAPWWEFan' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#5PRIVATE' visibility = 'PRIVATE' creationdat = '20200420' creator = '_SAPWWEFan' ) TO tags.

    APPEND VALUE #( mandt = sy-mandt langu = 'D' tag = 'TAG#1' text = 'Das ist ein Test') TO tagts.
    APPEND VALUE #( mandt = sy-mandt langu = 'E' tag = 'TAG#1' text = 'This is a test') TO tagts.
    APPEND VALUE #( mandt = sy-mandt langu = 'D' tag = 'TAG#5' text = 'Das ist ein Test') TO tagts.
    APPEND VALUE #( mandt = sy-mandt langu = 'D' tag = 'TAG#5PRIVATE' text = 'Das ist ein Test') TO tagts.

    APPEND VALUE #( mandt = sy-mandt varname = 'ABC' ) TO variants.
    APPEND VALUE #( mandt = sy-mandt varname = 'DEF' ) TO variants.
    APPEND VALUE #( mandt = sy-mandt varname = 'GHI' ) TO variants.
    APPEND VALUE #( mandt = sy-mandt varname = 'JKL' ) TO variants.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'ABC' ) TO tag_maps.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'GHI' ) TO tag_maps.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'JKL' ) TO tag_maps.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1PRIVATE' varname = 'JKL' ) TO tag_maps.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' varname = 'DEF' ) TO tag_maps.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' varname = 'JKL' ) TO tag_maps.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#3' varname = 'GHI' ) TO tag_maps.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#4' varname = 'ABC' ) TO tag_maps.


    environment->insert_test_data(
      EXPORTING
        i_data             = tags
    ).

    environment->insert_test_data(
      EXPORTING
        i_data             = tagts
    ).

    environment->insert_test_data(
      EXPORTING
        i_data             = variants
    ).

    environment->insert_test_data(
      EXPORTING
        i_data             = tag_maps
    ).

    DATA(pers_num_dao) = NEW lcl_pers_num_test_dao_impl( ).

    cl_ptf_variant_tag_manager=>pers_number_dao = pers_num_dao.


    DATA(act_bliss_variants) = cl_ptf_variant_tag_manager=>read_tagged_variants_for_user( user =  '_SAPBliss' ).

    pers_num_dao->pers_number_to_return = 'Flair'.

    DATA(act_flair_variants) = cl_ptf_variant_tag_manager=>read_tagged_variants_for_user( user = 'Flair' ).


    cl_abap_unit_assert=>assert_equals(
      act = act_bliss_variants
      exp = exp_bliss_variants ).

    cl_abap_unit_assert=>assert_equals(
      act = act_flair_variants
      exp = exp_flair_variants ).

  ENDMETHOD.


  METHOD set_Autogenerated_Data_For_Tag.

    DATA: ptf_tag_entry TYPE v_ptf_var_tag.

    DATA(pers_num_dao) = NEW lcl_pers_num_test_dao_impl( ).

    cl_ptf_variant_tag_manager=>pers_number_dao = pers_num_dao.

    cl_ptf_variant_tag_manager=>set_autogenerated_data_for_tag(
      EXPORTING
        date        = sy-datum
        user        = '_SAPBliss'
      CHANGING
        ptf_var_tag = ptf_tag_entry
    ).

    cl_abap_unit_assert=>assert_equals(
      act = ptf_tag_entry-creator
      exp = '_SAPBliss' ).

    cl_abap_unit_assert=>assert_equals(
      act = ptf_tag_entry-creationdat
      exp = sy-datum ).

    CLEAR ptf_tag_entry.

    pers_num_dao->pers_number_to_return = 'Flair'.

    cl_ptf_variant_tag_manager=>set_autogenerated_data_for_tag(
      EXPORTING
        date        = sy-datum
        user        = 'Flair'
      CHANGING
        ptf_var_tag = ptf_tag_entry
    ).

    cl_abap_unit_assert=>assert_equals(
      act = ptf_tag_entry-creator
      exp = '_SAPFlair' ).

    cl_abap_unit_assert=>assert_equals(
      act = ptf_tag_entry-creationdat
      exp = sy-datum ).

  ENDMETHOD.


  METHOD transport_Ptf_Variant_Tags.

    DATA: tags      TYPE cl_ptf_variant_tag_manager=>ptf_tags,
          tagts     TYPE cl_ptf_variant_tag_manager=>ptf_tag_texts,
          tag_maps  TYPE cl_ptf_variant_tag_manager=>ptf_var_tag_map_table,
          exp_e071k TYPE lif_transport_manager_dao=>tt_e071k,
          exp_ko200 TYPE lif_transport_manager_dao=>tt_ko200.

    DATA(transport_dao) = NEW lcl_trans_mgr_test_dao_impl( ).

    cl_ptf_variant_tag_manager=>transport_dao = transport_dao.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1'  visibility = 'PUBLIC' creationdat = '20200420' creator = '_SAPBliss' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'YTAG#8' visibility = 'PUBLIC' creationdat = '20200420' creator = '_SAPBliss' ) TO tags.
