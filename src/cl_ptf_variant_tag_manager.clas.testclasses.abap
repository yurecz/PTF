    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2'  varname = 'JKL' ) TO tag_maps.

    cl_ptf_variant_tag_manager=>transport_ptf_variant_tags(
      EXPORTING
        ptf_var_tags                = tags
        ptf_var_tag_texts           = tagts
        deleted_var_tag_map_entries = tag_maps
    ).


    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' Objname = 'PTF_VAR_TAG' mastername = 'PTF_VAR_TAG' mastertype = 'TABU' tabkey = |{ sy-mandt WIDTH = 3 }{ 'TAG#1' WIDTH = 80 }|  lang = sy-langu ) TO exp_e071k.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' Objname = 'PTF_VAR_TAG' mastername = 'PTF_VAR_TAG' mastertype = 'TABU' tabkey = |{ sy-mandt WIDTH = 3 }{ 'TAG#1PRIVATE' WIDTH = 80 }|  lang = sy-langu ) TO exp_e071k.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' Objname = 'PTF_VAR_TAGT' mastername = 'PTF_VAR_TAGT' mastertype = 'TABU' tabkey = |{ sy-mandt WIDTH = 3 }{ 'D' WIDTH = 1 }{ 'TAG#1' WIDTH = 80 }|  lang = sy-langu ) TO exp_e071k.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' Objname = 'PTF_VAR_TAGT' mastername = 'PTF_VAR_TAGT' mastertype = 'TABU' tabkey = |{ sy-mandt WIDTH = 3 }{ 'E' WIDTH = 1 }{ 'TAG#1' WIDTH = 80 }|  lang = sy-langu ) TO exp_e071k.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' Objname = 'PTF_VAR_TAG_MAP' mastername = 'PTF_VAR_TAG_MAP' mastertype = 'TABU' tabkey = |{ sy-mandt WIDTH = 3 }{ 'TAG#2' WIDTH = 80 }{ 'DEF' WIDTH = 31 }|  lang = sy-langu ) TO exp_e071k.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' Objname = 'PTF_VAR_TAG_MAP' mastername = 'PTF_VAR_TAG_MAP' mastertype = 'TABU' tabkey = |{ sy-mandt WIDTH = 3 }{ 'TAG#2' WIDTH = 80 }{ 'JKL' WIDTH = 31 }|  lang = sy-langu ) TO exp_e071k.

    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' obj_name = 'PTF_VAR_TAG' objfunc = 'K' lang = sy-langu ) TO exp_ko200.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' obj_name = 'PTF_VAR_TAG' objfunc = 'K' lang = sy-langu ) TO exp_ko200.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' obj_name = 'PTF_VAR_TAGT' objfunc = 'K' lang = sy-langu ) TO exp_ko200.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' obj_name = 'PTF_VAR_TAGT' objfunc = 'K' lang = sy-langu ) TO exp_ko200.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' obj_name = 'PTF_VAR_TAG_MAP' objfunc = 'K' lang = sy-langu ) TO exp_ko200.
    APPEND VALUE #( pgmid = 'R3TR' object = 'TABU' obj_name = 'PTF_VAR_TAG_MAP' objfunc = 'K' lang = sy-langu ) TO exp_ko200.

    cl_abap_unit_assert=>assert_equals(
      act = transport_dao->e071k
      exp = exp_e071k ).

    cl_abap_unit_assert=>assert_equals(
      act = transport_dao->ko200
