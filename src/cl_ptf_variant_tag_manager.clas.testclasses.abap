  METHOD is_Admin.
    DATA(pers_num_dao) = NEW lcl_pers_num_test_dao_impl( ).
    cl_ptf_variant_tag_manager=>pers_number_dao = pers_num_dao.

    pers_num_dao->pers_number_to_return = 'D021185'.

    cl_abap_unit_assert=>assert_equals(
      act = cl_ptf_variant_tag_manager=>is_admin( user = 'PODHAJSKY' )
      exp = abap_true ).

    pers_num_dao->pers_number_to_return = 'D040401'.

    cl_abap_unit_assert=>assert_equals(
      act = cl_ptf_variant_tag_manager=>is_admin( user = 'KRENZER' )
      exp = abap_true ).

    pers_num_dao->pers_number_to_return = 'D049099'.

