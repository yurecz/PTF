  METHOD convert_User_Name.

    DATA(pers_num_dao) = NEW lcl_pers_num_test_dao_impl( ).

    cl_ptf_variant_tag_manager=>pers_number_dao = pers_num_dao.

    pers_num_dao->pers_number_to_return = 'D072204'.

    DATA(actual_value) = cl_ptf_variant_tag_manager=>convert_user_name( user = 'ItsMe:-)' ).

    cl_abap_unit_assert=>assert_equals(
      act = actual_value
      exp = '_SAPD072204' ).


    pers_num_dao->pers_number_to_return = ''.

    actual_value = cl_ptf_variant_tag_manager=>convert_user_name( user = 'OHRM' ).

    cl_abap_unit_assert=>assert_equals(
      act = actual_value
      exp = '_SAPOHRM' ).

  ENDMETHOD.


  METHOD delete_Maps_For_Tags.
    DATA: tags                TYPE STANDARD TABLE OF ptf_var_tag,
          variants            TYPE STANDARD TABLE OF ptf_varid,
          tag_maps            TYPE STANDARD TABLE OF ptf_var_tag_map,
          input_tags          TYPE cl_ptf_variant_tag_manager=>ptf_tags,
          expected_db_content TYPE STANDARD TABLE OF ptf_var_tag_map.


    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'ABC' ) TO expected_db_content.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'GHI' ) TO expected_db_content.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'JKL' ) TO expected_db_content.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#3' varname = 'GHI' ) TO expected_db_content.


    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' visibility = 'PUBLIC' creationdat = '20200420' creator = 'AlexaBliss' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' visibility = 'PUBLIC' creationdat = '20200420' creator = 'BeckyLynch' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#3' visibility = 'PUBLIC' creationdat = '20200420' creator = 'SashaBanks' ) TO tags.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#4' visibility = 'PUBLIC' creationdat = '20200420' creator = 'CharlotteFlair' ) TO tags.

    APPEND VALUE #( mandt = sy-mandt varname = 'ABC' ) TO variants.
    APPEND VALUE #( mandt = sy-mandt varname = 'DEF' ) TO variants.
    APPEND VALUE #( mandt = sy-mandt varname = 'GHI' ) TO variants.
    APPEND VALUE #( mandt = sy-mandt varname = 'JKL' ) TO variants.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'ABC' ) TO tag_maps.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'GHI' ) TO tag_maps.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#1' varname = 'JKL' ) TO tag_maps.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' varname = 'DEF' ) TO tag_maps.
    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2' varname = 'JKL' ) TO tag_maps.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#3' varname = 'GHI' ) TO tag_maps.

    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#4' varname = 'ABC' ) TO tag_maps.


    environment->insert_test_data(
      EXPORTING
        i_data             = tags
    ).

    environment->insert_test_data(
      EXPORTING
        i_data             = variants
    ).

    environment->insert_test_data(
      EXPORTING
        i_data             = tag_maps
    ).


    APPEND 'TAG#2' TO input_tags.
    APPEND 'TAG#4' TO input_tags.

    cl_ptf_variant_tag_manager=>delete_maps_for_tags( tags = input_tags ).

    SELECT * FROM ptf_var_tag_map ORDER BY tag, varname ASCENDING INTO TABLE @DATA(actual_db_content).

    cl_abap_unit_assert=>assert_equals(
      act = actual_db_content
      exp = expected_db_content ).


    CLEAR input_tags.

    cl_ptf_variant_tag_manager=>delete_maps_for_tags( tags = input_tags ).




  ENDMETHOD.


