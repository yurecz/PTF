    APPEND VALUE #( mandt = sy-mandt tag = 'TAG#2'  varname = 'DEF' ) TO tag_maps.
    APPEND VALUE #( mandt = sy-mandt tag = 'ZTAG#9' varname = 'DEF' ) TO tag_maps.
